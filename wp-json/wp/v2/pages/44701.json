42 e-con-boxed e-flex e-con e-parent\" data-id=\"2a44f42\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-fc380e7 elementor-widget elementor-widget-heading\" data-id=\"fc380e7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Why use nDPI for deep packet inspection?<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7c6be57 elementor-widget elementor-widget-text-editor\" data-id=\"7c6be57\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>nDPI is the open source deep packet inspection library used by ntopng and nProbe. It recognizes 450+ protocols and applications, including encrypted traffic, using metadata such as TLS fingerprints and DNS, without decrypting the payload. Because it is open source, the same detections follow you across the ntop products and your own tools.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-e3b0d4f e-flex e-con-boxed e-con e-parent\" data-id=\"e3b0d4f\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-d4735fb e-con-full e-flex e-con e-parent\" data-id=\"d4735fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-9d3cb33 e-con-full e-flex e-con e-parent\" data-id=\"9d3cb33\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-d0592dd elementor-widget elementor-widget-text-editor\" data-id=\"d0592dd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>Get started<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3548d72 elementor-widget elementor-widget-heading\" data-id=\"3548d72\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Not sure which one to choose?<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9f67c91 elementor-widget elementor-widget-text-editor\" data-id=\"9f67c91\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>Download the free Community edition, compare editions and buy in the shop, or talk to the ntop team about your requirements.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-2a6a8a6 e-con-full e-flex e-con e-parent\" data-id=\"2a6a8a6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-11c6f54 elementor-widget elementor-widget-lte-button\" data-id=\"11c6f54\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"lte-button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"lte-btn-wrap\">\r\n\t<a href=\"https:\/\/www.ntop.org\/support\/documentation\/software-installation\/\"  class=\"lte-btn color-hover-default lte-icon-style-default\"><span class=\"lte-btn-inner\"><span class=\"lte-btn-before\"><\/span>Download free<span class=\"lte-btn-after\"><\/span><\/span><\/a><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e082560 elementor-widget elementor-widget-lte-button\" data-id=\"e082560\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"lte-button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"lte-btn-wrap\">\r\n\t<a href=\"https:\/\/shop.ntop.org\"  target=\"_blank\"  class=\"lte-btn